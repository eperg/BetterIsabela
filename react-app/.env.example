# BetterIsabela app — server configuration
#
#   cp .env.example .env    then fill in the values
#
# .env is git-ignored. UNLIKE the legacy static site, this app HAS real
# server-side secrets: everything below stays on the server and must never be
# exposed to the browser. Only variables prefixed NEXT_PUBLIC_ reach client code.
#
# In production these live in Vercel project environment variables, not in a file.

# ──────────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase or any Postgres 14+).
# Leave unset, or set to "pglite", to run against an in-process WASM Postgres in
# .pglite/ — no database server required. Production must use a real URL.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Connection pool size. Keep it small — serverless functions each hold a pool.
# Use 1 against the local PGlite socket server (npm run db:serve).
DATABASE_POOL_MAX=1
# Set to false behind a transaction-mode pooler (PgBouncer, Supabase pooler,
# Neon pooled endpoint), which cannot carry per-connection prepared statements.
# DATABASE_PREPARE=false

# ──────────────────────────────────────────────────────────────────────────────
# eGov PH — Single Sign-On
# ──────────────────────────────────────────────────────────────────────────────
# Issued by the eGov administrator at platforms.e.gov.ph.
# partner_secret is exchanged server-side only; it is not an public identifier.
EGOV_PARTNER_CODE=
EGOV_PARTNER_SECRET=
# The scope accepted by POST /api/token. The endpoint validates this against a
# fixed list — take the exact value from the SSO page in the API catalog.
EGOV_SSO_SCOPE=
EGOV_OAUTH_BASE=https://oauth.e.gov.ph
EGOV_TIMEOUT_MS=15000

# ──────────────────────────────────────────────────────────────────────────────
# eGov PH — other platform APIs
# ──────────────────────────────────────────────────────────────────────────────
# eVerify — identity verification (sets users.verified_at)
EGOV_EVERIFY_CLIENT_ID=
EGOV_EVERIFY_CLIENT_SECRET=
EGOV_EVERIFY_PUBKEY=

# eMessage — notifications
EGOV_EMESSAGE_ACCESS_TOKEN=

# eGov AI
EGOV_AI_ACCESS_CODE=

# eGovPay — payments
EGOV_PAY_API_KEY=
EGOV_PAY_SETTLEMENT_TEMPLATE_UUID=

# eReport
EGOV_EREPORT_ACCESS_TOKEN=

# Face Liveness
EGOV_FACE_LIVENESS_API_KEY=

# Compass (DBM)
EGOV_COMPASS_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
SITE_URL=https://betterisabela.org
# Absolute URL eGov redirects back to after the citizen signs in.
EGOV_REDIRECT_URI=https://betterisabela.org/auth/callback
# Random 32+ byte string; signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
