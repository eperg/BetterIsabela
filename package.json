{
  "name": "bs-web",
  "version": "1.1.19",
  "description": "BetterIsabela.org - Official Portal for PLGU Isabela",
  "scripts": {
    "dev": "python3 serve.py --port 8000 --directory .",
    "build": "bash build.sh",
    "build:major": "bash scripts/version.sh major && bash build.sh --no-bump",
    "build:minor": "bash scripts/version.sh minor && bash build.sh --no-bump",
    "serve": "python3 serve.py --port 8000 --directory .",
    "serve:dist": "python3 serve.py --port 8080 --directory dist",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "version:check": "node scripts/bump-version.js",
    "validate:links": "node scripts/check-internal-links.js",
    "validate:css": "node scripts/check-css-sync.js",
    "validate:http": "node scripts/crawl-site.js",
    "audit:external": "node scripts/check-external-links.js",
    "sync:prices": "node scripts/sync-prices.js",
    "sync:towns": "node scripts/sync-towns.js",
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bash scripts/package-cpanel.sh --build",
    "package:only": "bash scripts/package-cpanel.sh"
  },
  "keywords": [
    "isabela",
    "cagayan-valley",
    "government",
    "lgu"
  ],
  "author": "Eper Gaboni",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.23.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.40.0",
    "html-minifier-terser": "^7.2.0",
    "node-html-parser": "^9.0.1",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "terser": "^5.44.1"
  },
  "overrides": {
    "tmp": "0.2.7",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  }
}
